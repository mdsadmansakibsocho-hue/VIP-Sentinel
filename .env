DISCORD_TOKEN=***token***
OWNER_ID=**your**discord**id
# Optional trusted users, comma separated
TRUSTED_USER_IDS=

# Security settings
RAID_JOIN_THRESHOLD=6
RAID_JOIN_WINDOW_SECONDS=10
ACTION_THRESHOLD=4
ACTION_WINDOW_SECONDS=8
AUTO_LOCKDOWN=true
AUTO_PUNISH=true
PUNISHMENT=timeout
LOG_CHANNEL_NAME=vip-security-logs
